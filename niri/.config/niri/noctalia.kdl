layout {

    focus-ring {
        active-color   "#a0e467"
        inactive-color "#1d2d10"
        urgent-color   "#fd4663"
    }

    border {
        active-color   "#a0e467"
        inactive-color "#1d2d10"
        urgent-color   "#fd4663"
    }


    tab-indicator {
        active-color   "#a0e467"
        inactive-color "#478514"
        urgent-color   "#fd4663"
    }

    insert-hint {
        color "#a0e46780"
    }
}

recent-windows {
    highlight {
        active-color "#a0e467"
        urgent-color "#fd4663"
    }
}
