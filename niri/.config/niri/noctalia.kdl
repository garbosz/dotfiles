layout {

    focus-ring {
        active-color   "#e4c367"
        inactive-color "#262218"
        urgent-color   "#fd4663"
    }

    border {
        active-color   "#e4c367"
        inactive-color "#262218"
        urgent-color   "#fd4663"
    }


    tab-indicator {
        active-color   "#e4c367"
        inactive-color "#856714"
        urgent-color   "#fd4663"
    }

    insert-hint {
        color "#e4c36780"
    }
}

recent-windows {
    highlight {
        active-color "#e4c367"
        urgent-color "#fd4663"
    }
}
